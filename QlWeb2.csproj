<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- site/ is what GitHub Pages publishes and build/ is the tooling that made it. Neither is
         part of the running app, but the Web SDK's default glob picks up every .json under the
         project, so a publish was copying site/_data/*.json into the deployment. -->
    <!-- QlWeb2.Tests is a separate project nested in this folder. Without this the web
         project compiles the test files too, and every xunit attribute comes back undefined. -->
    <Compile Remove="QlWeb2.Tests/**" />
    <Content Remove="QlWeb2.Tests/**" />
    <None Remove="QlWeb2.Tests/**" />

    <!-- import/ is the crawled source material this site was built FROM - 3.8 MB of it,
         including the Vietnamese originals the English edition deliberately does not use - and
         export/ is a stale partial static export. Neither is part of the running app, and both
         were riding along into the deployment until the first publish to a real server was
         packaged on 28/09/2026. clone-report.json goes with them: a crawl log naming the site
         this one was built from, which has no business on a public server. -->
    <!-- Dua lai nhung tep duoi wwwroot co chu "node_modules" trong duong dan.
         DefaultItemExcludes cua Web SDK bo **/node_modules/** o moi noi. Dung cho mot thu muc
         phu thuoc that (tools/node_modules), va SAI o day: ban crawl giu nguyen duong dan ma
         cac trang tro toi, va muoi hai trong so do tinh co co chu "node_modules". Chung vang
         mat im lang khoi lan trien khai dau tien - hai tep CSS 404 tren moi trang va bon tep
         script khong tai duoc - crawl.js chay len may chu that moi phat hien ra. -->
    <Content Include="wwwroot/**/node_modules/**" CopyToPublishDirectory="PreserveNewest" />

    <Compile Remove="site/**;build/**;tools/**;docs/**;import/**;export/**;clone-report.json" />
    <Content Remove="site/**;build/**;tools/**;docs/**;import/**;export/**;clone-report.json" />
    <None Remove="site/**;build/**;tools/**;docs/**;import/**;export/**;clone-report.json" />
  </ItemGroup>

</Project>
