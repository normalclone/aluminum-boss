@model List<QlWeb2.Areas.Admin.Controllers.CollectionController.Summary>
@{ ViewData["Title"] = "Content"; }

<h1>Content</h1>
<p class="ad-sub">
    Ten kinds of thing on the site. Open one to add, remove, reorder or hide an item; to change
    what an item says, open its page in the editor &mdash; you can see it there.
</p>

<div class="ad-cards">
    @foreach (var s in Model)
    {
        <a class="ad-card" asp-action="Items" asp-route-id="@s.Kind.Key">
            <b>@s.Kind.Label</b>
            <span>@s.Items @(s.Items == 1 ? "item" : "items")</span>
        </a>
    }
</div>
