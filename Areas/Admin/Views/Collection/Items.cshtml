@using QlWeb2.Areas.Admin.Controllers
@model List<CollectionController.Row>
@{
    var kind = (CollectionController.Kind)ViewData["Kind"]!;
    var confirming = TempData["Confirm"] as int?;
    var choices = (List<CollectionController.Choice>)ViewData["Choices"]!;
}

<p class="ad-crumb"><a asp-action="Index">Content</a> &nbsp;/&nbsp; @kind.Label</p>
<h1>@kind.Label</h1>
<p class="ad-sub">
    @Model.Count @(Model.Count == 1 ? "item" : "items"), in the order the site shows them.
    @if (kind.HasOwnPage)
    {
        <text>Each one has a page of its own.</text>
    }
    else
    {
        <text>These appear on the home page.</text>
    }
    @if (kind.Source is { } from)
    {
        var one = from.One.ToLowerInvariant();
        <text>
            Each card stands for @(one.StartsWith("a") || one.StartsWith("e") || one.StartsWith("i")
                                   || one.StartsWith("o") || one.StartsWith("u") ? "an" : "a")
            @one: its picture, its words and its link all come from there, so each of them is
            written once, in <a asp-action="Items" asp-route-id="@from.Key">@from.Label</a>.
            Choosing here is choosing which of them the home page shows, and in what order.
        </text>
        @if (Model.Count == 0)
        {
            <text>
                This shelf is empty, so the band picks for itself the way it always did. Add a
                card and the shelf takes over.
            </text>
        }
    }
</p>

@if (confirming is int index && TempData["ConfirmWhat"] is string what)
{
    <div class="ad-confirm">
        <p><b>Delete &ldquo;@what&rdquo;?</b> @TempData["ConfirmRefs"]</p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@kind.Key">
            <input type="hidden" name="index" value="@index">
            <input type="hidden" name="confirmed" value="true">
            <button type="submit" class="ad-btn ad-danger">Yes, delete it</button>
            <a class="ad-btn is-quiet" asp-action="Items" asp-route-id="@kind.Key">Keep it</a>
        </form>
    </div>
}

@if (kind.CanAdd)
{
    <form asp-action="Change" method="post" class="ad-addbar">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@kind.Key">
        <input type="hidden" name="index" value="0">
        <input type="hidden" name="op" value="Add">
        <button type="submit" class="ad-btn">Add an item</button>
    </form>
}
else
{
    <p class="ad-addbar ad-note">
        Adding to this list needs map coordinates, which are not text on the page &mdash; ask a
        developer. Everything else works: hide an item, move it, remove it, and edit its words
        on the home page.
    </p>
}

<table>
    <thead>
        <tr>
            <th class="ad-num">#</th>
            <th></th>
            <th>Item</th>
            @if (kind.Source is { } sourceKind)
            {
                <th>@sourceKind.One</th>
            }
            <th>Shown</th>
            <th>Order</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @for (var i = 0; i < Model.Count; i++)
    {
        var row = Model[i];
        <tr class="@(row.Visible ? "" : "is-off")">
            <td class="ad-num">@(i + 1)</td>
            <td class="ad-thumbcell">
                @if (row.Image is not null)
                {
                    <img src="@row.Image" alt="" loading="lazy">
                }
                else
                {
                    <span class="ad-nothumb">&mdash;</span>
                }
            </td>
            <td>
                <b>@row.Title</b>
                @if (row.Note.Length > 0)
                {
                    <span class="ad-note">@row.Note</span>
                }
            </td>
            @if (kind.Source is { } src)
            {
                @* Which library item this card is for. The picture, the words and the link all
                   come from it, so this one control is the whole of what makes the card that
                   card. *@
                <td class="ad-pick">
                    <form asp-action="Link" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@kind.Key">
                        <input type="hidden" name="index" value="@row.Index">
                        <select name="to" aria-label="@src.One for this card">
                            @if (!choices.Any(c => c.Id == row.Id))
                            {
                                <option value="" selected>Not chosen yet</option>
                            }
                            @foreach (var c in choices)
                            {
                                <option value="@c.Id" selected="@(c.Id == row.Id)">@c.Title</option>
                            }
                        </select>
                        <button type="submit" class="ad-move"
                                title="Point this card at that @src.One.ToLowerInvariant()">Set</button>
                    </form>
                    @if (row.Warn is not null)
                    {
                        <span class="ad-note">@row.Warn</span>
                    }
                </td>
            }
            <td>
                <form asp-action="Change" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@kind.Key">
                    <input type="hidden" name="index" value="@row.Index">
                    <input type="hidden" name="op" value="@(row.Visible ? "Hide" : "Show")">
                    <button type="submit" class="ad-plain ad-state">
                        @(row.Visible ? "Shown" : "Hidden")
                    </button>
                </form>
            </td>
            <td class="ad-order">
                <form asp-action="Change" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@kind.Key">
                    <input type="hidden" name="index" value="@row.Index">
                    <input type="hidden" name="op" value="Up">
                    <button type="submit" class="ad-move" title="Move up" disabled="@(i == 0)">&uarr;</button>
                </form>
                <form asp-action="Change" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@kind.Key">
                    <input type="hidden" name="index" value="@row.Index">
                    <input type="hidden" name="op" value="Down">
                    <button type="submit" class="ad-move" title="Move down" disabled="@(i == Model.Count - 1)">&darr;</button>
                </form>
            </td>
            <td class="ad-right-cell">
                <a class="ad-btn is-quiet" asp-area="Admin" asp-controller="Edit" asp-action="Index"
                   asp-route-page="@row.Page">Edit</a>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@kind.Key">
                    <input type="hidden" name="index" value="@row.Index">
                    <button type="submit" class="ad-plain ad-danger-plain">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
