@using QlWeb2.Areas.Admin.Controllers
@model List<HistoryController.Entry>
@{
    var documents = (IReadOnlyList<string>)ViewData["Documents"]!;
    var filter = ViewData["Filter"] as string;
}

<h1>History</h1>
<p class="ad-sub">
    Every save keeps the version it replaced. Look at one before you restore it &mdash; and
    restoring keeps the current version too, so there is always a way back.
</p>

<p class="ad-filter">
    <a class="ad-chip @(filter is null ? "is-on" : "")" asp-action="Index">Everything</a>
    @foreach (var name in documents)
    {
        <a class="ad-chip @(filter == name ? "is-on" : "")"
           asp-action="Index" asp-route-name="@name">@name</a>
    }
</p>

@if (Model.Count == 0)
{
    <p class="ad-empty">
        Nothing yet. A version appears here the first time something is saved over.
    </p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Saved</th>
                <th>Content</th>
                <th>By</th>
                <th>Size</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.SavedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm:ss")</td>
                <td><b>@e.Name</b></td>
                <td>@e.SavedBy</td>
                <td class="ad-num">@(Math.Round(e.Bytes / 1024.0, 1)) KB</td>
                <td class="ad-right-cell">
                    <a class="ad-btn is-quiet" asp-action="Show" asp-route-id="@e.Id"
                       target="_blank" rel="noopener">Look at it</a>
                    <form asp-action="Restore" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@e.Id">
                        <button type="submit" class="ad-plain">Restore this version</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
