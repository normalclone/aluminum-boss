@*
    The admin shell.

    Its stylesheet is separate from the public site's and is never loaded by it: the site's CSS is
    the thing being preserved pixel for pixel, and an admin style that leaked into it would be a
    slow way to break exactly what this port is measured on.
*@
@inject QlWeb2.Areas.Admin.FirstPassword First
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>@ViewData["Title"] — Site content</title>
    @* Without this the browser asks for /favicon.ico on every admin page and gets a 404. The
       public pages already declare it; this half of the app never did. *@
    <link rel="icon" href="/_media/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="~/admin/admin.css" asp-append-version="true">
    @if (ViewData["Wide"] is true)
    {
        <link rel="stylesheet" href="~/admin/editor.css" asp-append-version="true">
    }
</head>
<body>
<header class="ad-top">
    <a class="ad-brand" asp-area="Admin" asp-controller="Edit" asp-action="Index">Site content</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @*
            Five links, and there were nine.

            Overview, Content, Page order and Search listing read and wrote ContentDocuments,
            PageRegions and PageSeos - tables nothing served from any more. They were taken off
            this bar at Task 11 and deleted at Task 15: they still drew, and their Save buttons
            still said "Saved", which is a worse thing to hand someone than a missing screen.
            Anybody who had bookmarked one now gets a 404, which is the truth.

            What replaced them: Content is Task 12's collection lists, Search listing became
            generated tags (Task 13), History is Task 14, and the running order of the home page
            lives in the documents the editor writes.
        *@
        @* Hidden while the seeded password is still in force: every one of these bounces back
           to Change password, and five links that all go to the same place read as a fault. *@
        @if (!First.Still)
        {
            <nav class="ad-nav">
                <a asp-area="Admin" asp-controller="Edit" asp-action="Index">Edit pages</a>
                <a asp-area="Admin" asp-controller="Collection" asp-action="Index">Content</a>
                <a asp-area="Admin" asp-controller="Media" asp-action="Index">Pictures</a>
                <a asp-area="Admin" asp-controller="Enquiry" asp-action="Index">Enquiries</a>
                <a asp-area="Admin" asp-controller="History" asp-action="Index">History</a>
            </nav>
        }
        <div class="ad-right">
            <a class="ad-view" href="/" target="_blank" rel="noopener">View site</a>
            <a asp-area="Admin" asp-controller="Account" asp-action="Password">@User.Identity.Name</a>
            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="ad-plain">Sign out</button>
            </form>
        </div>
    }
</header>

<main class="ad-main@(ViewData["Wide"] is true ? " is-wide" : "")">
    @if (TempData["Flash"] is string flash)
    {
        <p class="ad-flash">@flash</p>
    }
    @if (TempData["Error"] is string error)
    {
        <p class="ad-flash is-bad">@error</p>
    }
    @RenderBody()
</main>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
