@{
    ViewData["Title"] = "Change password";
    var forced = ViewData["Forced"] is true;
}

<h1>Change password</h1>

@if (forced)
{
    @* Named, not hinted at. "For security reasons" tells the operator nothing they can act on;
       the account name and the fact that the password is published do. *@
    <div class="ad-confirm">
        <p><b>Do this before anything else.</b> The @User.Identity?.Name account still has the
        password it was created with, and that password is printed in this project's source code.
        Until it is changed, every other screen in here leads back to this one.</p>
        <p class="ad-note">Nothing you have saved is lost — the site is running normally, and the
        rest of the admin comes back the moment this form is submitted.</p>
    </div>
}

<p class="ad-sub">At least ten characters. A short phrase you will remember beats a short word you will not.</p>

@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
{
    <p class="ad-error">@error.ErrorMessage</p>
}

<form method="post" asp-area="Admin" asp-controller="Account" asp-action="Password" style="max-width:420px">
    @Html.AntiForgeryToken()

    <div class="ad-field">
        <label for="current">Current password</label>
        <input type="password" id="current" name="current" autocomplete="current-password" required>
    </div>

    <div class="ad-field">
        <label for="next">New password</label>
        <input type="password" id="next" name="next" autocomplete="new-password" minlength="10" required>
    </div>

    <div class="ad-field">
        <label for="confirm">New password again</label>
        <input type="password" id="confirm" name="confirm" autocomplete="new-password" minlength="10" required>
    </div>

    <div class="ad-actions">
        <button type="submit" class="ad-save">Change password</button>
        @* No way out while this is the only screen that answers: a Cancel that lands back here
           looks like a broken button rather than a rule. *@
        @if (!forced)
        {
            <a class="ad-btn is-quiet" asp-area="Admin" asp-controller="Edit" asp-action="Index">Cancel</a>
        }
    </div>
</form>
