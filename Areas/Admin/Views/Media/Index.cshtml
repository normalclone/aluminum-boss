@model List<QlWeb2.Content.MediaLibrary.Picture>
@{ ViewData["Title"] = "Pictures"; }

<h1>Pictures</h1>
@* This screen is for looking at the library and clearing it out. Pictures are chosen - and
   uploaded - in Edit pages, where the slot they go into is on the screen beside them; this used
   to say "paste its file name into an image field under Content", and Content has no image
   fields at all. *@
<p class="ad-sub">
    Every picture on the site. To put one <em>into</em> a page, go to
    <a asp-area="Admin" asp-controller="Edit" asp-action="Index">Edit pages</a> and click the
    picture you want to replace — the panel there tells you the size that fits it.
</p>
<p class="ad-sub">
    JPG, PNG, WebP or GIF, up to 20 MB. Nothing here is resized, so keep the long edge at
    2000 px or under: a photograph straight off a camera costs every visitor several megabytes
    to look at a picture the page draws a few hundred pixels wide.
</p>

<form class="ad-drop" method="post" enctype="multipart/form-data"
      asp-area="Admin" asp-controller="Media" asp-action="Upload">
    @Html.AntiForgeryToken()
    <input type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif" required>
    <button type="submit" class="ad-save" style="margin-left:10px">Upload</button>
</form>

@if (Model.Count == 0)
{
    <p>No pictures yet.</p>
}
else
{
    <div class="ad-media">
    @foreach (var item in Model)
    {
        <figure>
            <img src="/_media/@item.Name" alt="" loading="lazy">
            <figcaption>
                @item.Name
                <span class="ad-num">@((item.Bytes / 1024).ToString("N0")) KB · @item.Modified.ToLocalTime().ToString("d MMM yyyy")</span>
                <form method="post" asp-area="Admin" asp-controller="Media" asp-action="Delete" style="margin-top:7px"
                      onsubmit="return confirm('Delete @item.Name? Any page still using it will show a blank space.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="name" value="@item.Name">
                    <button type="submit" class="ad-plain">Delete</button>
                </form>
            </figcaption>
        </figure>
    }
    </div>
}
