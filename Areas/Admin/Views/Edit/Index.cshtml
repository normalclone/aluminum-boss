@{
    // The shell only. Fields arrive from the page in the frame - see wwwroot/admin/edit-bridge.js
    // for the contract the two halves are written against.
    Layout = "_AdminLayout";
    var pages = (List<QlWeb2.Areas.Admin.Controllers.EditController.PageLink>)ViewData["Pages"]!;
    var current = (string)ViewData["Page"]!;
    ViewData["Wide"] = true;
}

@* The editor posts JSON, so the token travels in a header rather than in a form. Wrapped,
   because a bare hidden input still occupies a line box - enough to make the document a little
   taller than the window, which is enough for one scroll to slide the header out from under a
   panel positioned against it. *@
<div hidden>@Html.AntiForgeryToken()</div>

@* Every other screen opens with an h1. This one is an app shell - the nav says where you
   are and the bar over the preview says which page - so the heading is there for structure
   rather than for the eye, and carries the page being edited because that is what changes. *@
<h1 class="ad-sr">Edit pages — @current</h1>

<div class="ed" data-ed-page="@current">
    <div class="ed-side">
        <div class="ed-pick">
            <label for="ed-page">Page</label>
            <select id="ed-page">
                @foreach (var p in pages)
                {
                    <option value="@p.Path" selected="@(p.Path == current)">@p.Label</option>
                }
            </select>
        </div>

        <p class="ed-note">
            Click any text or picture in the preview to find it here. Text changes show as you
            type; pictures and everything else appear when you save.
        </p>

        <div id="ed-fields" class="ed-fields">
            <p class="ed-empty">Loading the page&hellip;</p>
        </div>

        <div class="ed-save">
            <button type="button" id="ed-save" class="ad-save" disabled>Save changes</button>
            <span id="ed-save-note" class="ed-save-note"></span>
        </div>
    </div>

    <div class="ed-preview">
        <div class="ed-bar">
            <span class="ed-url" id="ed-url">@current</span>
            <div class="ed-widths" role="group" aria-label="Preview width">
                <button type="button" class="ed-w is-on" data-w="1440">Desktop 1440</button>
                <button type="button" class="ed-w" data-w="834">Tablet 834</button>
                <button type="button" class="ed-w" data-w="390">Phone 390</button>
            </div>
            <a class="ed-open" href="@current" target="_blank" rel="noopener">Open in a tab</a>
        </div>
        <div class="ed-stage" id="ed-stage">
            <iframe id="ed-frame" title="Preview" src="@(current)?edit=1"></iframe>
        </div>
    </div>
</div>

@* The picture library, over the preview rather than beside it: the choice needs the room, and
   while it is open there is nothing else to do. *@
<div class="ed-shelf" id="ed-shelf" hidden>
    <div class="ed-shelf-head">
        <h2>Choose a picture</h2>
        <label class="ad-btn is-quiet ed-upload">
            Add a picture
            <input type="file" id="ed-shelf-file" accept="image/jpeg,image/png,image/webp,image/gif">
        </label>
        <button type="button" class="ad-btn is-quiet" id="ed-shelf-close">Close</button>
    </div>
    @* What this particular hole is shaped like, and what to upload into it. Filled by the
       editor when the panel opens, because only the page knows the shape. Kept apart from
       ed-shelf-note below, which is a status line and gets overwritten by "Uploading…". *@
    <p class="ed-shelf-fit" id="ed-shelf-fit"></p>
    <p class="ed-shelf-note" id="ed-shelf-note"></p>
    <div class="ed-shelf-list" id="ed-shelf-list"></div>
</div>

@section Scripts {
    <script src="~/admin/editor.js" asp-append-version="true"></script>
}
