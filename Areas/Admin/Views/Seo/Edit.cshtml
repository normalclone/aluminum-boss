@model QlWeb2.Models.PageSeo
@{ ViewData["Title"] = "Search listing — " + Model.Label; }

<h1>@Model.Label</h1>
<p class="ad-sub">@Model.Path</p>

<form method="post" asp-area="Admin" asp-controller="Seo" asp-action="Edit" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()

    <div class="ad-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="@Model.Title" maxlength="120">
        <span class="ad-hint">Shown in the browser tab and as the headline in search results. Around 60 characters reads best.</span>
    </div>

    <div class="ad-field">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3" maxlength="320">@Model.Description</textarea>
        <span class="ad-hint">The paragraph under the headline in search results. Around 150 characters.</span>
    </div>

    <details class="ad-group">
        <summary>When the link is shared</summary>
        <div>
            <div class="ad-field">
                <label for="ogTitle">Title for shared links</label>
                <input type="text" id="ogTitle" name="ogTitle" value="@Model.OgTitle" maxlength="120">
                <span class="ad-hint">Leave empty to use the title above.</span>
            </div>
            <div class="ad-field">
                <label for="ogDescription">Description for shared links</label>
                <textarea id="ogDescription" name="ogDescription" rows="2" maxlength="320">@Model.OgDescription</textarea>
                <span class="ad-hint">Leave empty to use the description above.</span>
            </div>
            <div class="ad-field">
                <label for="ogImage">Picture for shared links</label>
                <div class="ad-image">
                    <img src="@(string.IsNullOrWhiteSpace(Model.OgImage) ? "" : "/_media/" + Model.OgImage)" alt=""
                         onerror="this.style.visibility='hidden'">
                    <input type="text" id="ogImage" name="ogImage" value="@Model.OgImage"
                           placeholder="File name from Pictures">
                </div>
            </div>
        </div>
    </details>

    <div class="ad-field ad-check">
        <input type="checkbox" id="noIndex" name="noIndex" value="true" checked="@Model.NoIndex">
        <label for="noIndex">Keep this page out of search results</label>
    </div>

    <div class="ad-actions">
        <button type="submit" class="ad-save">Save</button>
        <a class="ad-btn is-quiet" asp-area="Admin" asp-controller="Seo" asp-action="Index">Cancel</a>
        <a class="ad-btn is-quiet" href="@Model.Path" target="_blank" rel="noopener">View page</a>
    </div>
</form>
