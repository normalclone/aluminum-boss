@model QlWeb2.Controllers.NewsDetailsViewModel
@{
    var a = Model.Article;
}

<div class="article-hero">
  @Html.Media($"news-{a.Slug}", a.Title)
</div>

<div class="container">
  <div class="article-header">
    <p class="breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a> &gt; <a asp-action="Index">News</a> &gt; @a.Title</p>
    <h1>@a.Title</h1>
  </div>

  <div class="article-summary">
    <ul>
      @foreach (var bullet in a.Bullets)
      {
        <li>@bullet</li>
      }
    </ul>
  </div>

  <article class="article-body">
    @Html.Raw(a.BodyHtml)
  </article>

  <div class="article-tags">
    <p>Tags: @string.Join(", ", a.TagList) &nbsp;&middot;&nbsp; @a.PublishedAt.ToString("MMMM d, yyyy") &nbsp;&middot;&nbsp; Written by @a.Author</p>
  </div>

  <nav class="pagination">
    @if (Model.PrevSlug != null)
    {
      <a asp-action="Details" asp-route-slug="@Model.PrevSlug">&larr; Prev</a>
    }
    else
    {
      <span></span>
    }
    @if (Model.NextSlug != null)
    {
      <a asp-action="Details" asp-route-slug="@Model.NextSlug">Next &rarr;</a>
    }
  </nav>
</div>

<section class="section section-alt">
  <div class="container newsletter">
    <div>
      <h2 class="section-heading" style="font-size:26px;">Get Inspired With Our Newsletter</h2>
      <p style="color:var(--c-muted); font-size:14px; margin-top:8px;">Get updates on new products, colors, and the latest news.</p>
    </div>
    @Html.Media("newsletter", "Newsletter photo")
  </div>
</section>
