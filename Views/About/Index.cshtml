<section class="about-hero" style="@Html.BackgroundStyle("about-hero")">
  <h1>We Are Your Brand</h1>
</section>

<nav class="about-tabs">
  <a href="#about" class="is-active">01. About Us</a>
  <a href="#culture">02. Culture</a>
  <a href="#history">03. History</a>
  <a href="#impact">04. Impact</a>
  <a href="#people">05. People</a>
  <a href="#press">06. Press</a>
</nav>

<section class="about-block container" id="about">
  <div class="split">
    <div>
      <p class="about-block__eyebrow">About Us</p>
      <h2>Who We Are</h2>
      <p>A short company overview goes here &mdash; mission, what you make, and who you make it for. Replace with your real story once ready.</p>
    </div>
    @Html.Media("about-company", "Company overview photo")
  </div>
</section>

<section class="about-block section-alt" id="culture">
  <div class="container split">
    @Html.Media("about-culture", "Culture and team photo")
    <div>
      <p class="about-block__eyebrow">Culture</p>
      <h2>How We Work</h2>
      <p>A short paragraph about company culture, values, and how your teams collaborate day to day.</p>
    </div>
  </div>
</section>

<section class="about-block container" id="history">
  <p class="about-block__eyebrow" style="text-align:center;">History</p>
  <h2 style="text-align:center; max-width:600px; margin:0 auto var(--space-lg);">Milestones Along The Way</h2>
  <div class="stat-row">
    <div><p class="num">19XX</p><p class="label">Founded</p></div>
    <div><p class="num">XX</p><p class="label">Countries</p></div>
    <div><p class="num">XX</p><p class="label">Facilities</p></div>
    <div><p class="num">X,XXX</p><p class="label">Employees</p></div>
  </div>
</section>

<section class="about-block section-alt" id="impact">
  <div class="container split">
    <div>
      <p class="about-block__eyebrow">Impact</p>
      <h2>Sustainability &amp; Impact</h2>
      <p>A short paragraph on environmental commitments, certifications, and community impact.</p>
    </div>
    @Html.Media("about-sustainability", "Sustainability photo")
  </div>
</section>

<section class="about-block container" id="people">
  <div class="split">
    @Html.Media("about-people", "Team and people photo")
    <div>
      <p class="about-block__eyebrow">People</p>
      <h2>Meet The People</h2>
      <p>A short paragraph introducing leadership or team members, with photos and roles once real content is ready.</p>
    </div>
  </div>
</section>

<section class="about-block section-alt" id="press">
  <div class="container">
    <p class="about-block__eyebrow" style="text-align:center;">Press</p>
    <h2 style="text-align:center; max-width:600px; margin:0 auto var(--space-lg);">In The News</h2>
    <div class="card-grid card-grid--3">
      <div class="card">@Html.Media("press-01", "Press mention 1")<p class="card__title">Press mention headline placeholder</p></div>
      <div class="card">@Html.Media("press-02", "Press mention 2")<p class="card__title">Press mention headline placeholder</p></div>
      <div class="card">@Html.Media("press-03", "Press mention 3")<p class="card__title">Press mention headline placeholder</p></div>
    </div>
  </div>
</section>
