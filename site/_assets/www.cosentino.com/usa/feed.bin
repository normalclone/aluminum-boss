<div class="article-wrapper">
<section class="bg-section section-general-use-texto-imagen">
<div class="imagen-texto ">
<div class="left col-12 col-md-6">
<h2 class="font-40 font-light text-uppercase">Building a great team was foundational to my success</h2>
<div class="px-0 d-none d-tablet col-12">
<div id="slider-8414156a-84cf-49c7-9fa5-c423ce4b55bc_mobile" class="core-slider keen-slider">
<div class=" core-slider__slide keen-slider__slide number-slide-0" data-id="" data-src="https://imgix.cosentino.com/usa/wp-content/uploads/IMG_9888.jpeg?auto=format%2Ccompress&ixlib=php-3.3.0" >
                                                <img decoding="async" class="core-slider__slide__image" src="https://imgix.cosentino.com/usa/wp-content/uploads/IMG_9888.jpeg?auto=format%2Ccompress&amp;ixlib=php-3.3.0" alt="Image 55 of IMG 9888.jpeg?auto=format%2Ccompress&amp;ixlib=php 3.3 in Wish Kitchens and Baths - Cosentino" title="Image of IMG 9888.jpeg?auto=format%2Ccompress&amp;ixlib=php 3.3 - Cosentino"></p>
<div class="core-slider__slide__filter"></div>
<div class="core-slider__slide__card-body">
<div class="core-slider__slide__card-body__block"></div>
<div class="core-slider__slide__card-body__block">
<div class="core-slider__slide__card-body__arrow"></div>
</p></div>
</p></div>
</p></div>
<p>    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function() {
            const options = {
                id: "8414156a-84cf-49c7-9fa5-c423ce4b55bc_mobile",
