                hasModal: false,
                loop: false,
                ajaxUrl: "https://www.cosentino.com/usa/wp-admin/admin-ajax.php?action=get_slider_modal_info"
            };</p>
<p>            const sliderName = 'slider_' + '8414156a-84cf-49c7-9fa5-c423ce4b55bc_mobile';
            window[sliderName] = new SliderHorizontal(options);
        });
    </script>
</div>
</p></div>
<div class="text">
<div class="row mx-0 mr-lg-5">
<div class="paragraf px-0 col-lg-6">
<p class="font-15 font-light">Robbie Watson has been with Kitchen & Bath Galleries as an appliance specialist for over 25 years. During his tenure, he’s seen the evolution of kitchens. “We’re seeing color make its way back into the kitchen in a bold way,” he shared, “In the 90s, all-white kitchens were the trend, but now, color is being strategically incorporated.”</p>
</p></div>
<div class="paragraf px-0 col-lg-6">
<p class="font-15 font-light">“Customers are leaning into the marble aesthetic, but with the durability of products like Silestone and Dekton. We’re also seeing increased interest in Sensa natural stone,” shared Senior Designer Michelle Verrill. “Style, taste, and trends are ever-evolving, which pushes us to innovate while keeping the client at the core of the process.”</p>
</p></div>
</p></div>
</p></div>
</p></div>
<div class="d-tablet-none col-md-6 px-0">
<div id="slider-8414156a-84cf-49c7-9fa5-c423ce4b55bc" class="core-slider keen-slider">
<div class=" core-slider__slide keen-slider__slide number-slide-0" data-id="" data-src="https://imgix.cosentino.com/usa/wp-content/uploads/8L4A0618.jpg?auto=format%2Ccompress&ixlib=php-3.3.0" >
                                                <img decoding="async" class="core-slider__slide__image" src="https://imgix.cosentino.com/usa/wp-content/uploads/8L4A0618.jpg?auto=format%2Ccompress&amp;ixlib=php-3.3.0" alt="Image 104 of 8L4A0618.jpg?auto=format%2Ccompress&amp;ixlib=php 3.3 in Kitchen &amp; Bath Galleries - Cosentino" title="Image of 8L4A0618.jpg?auto=format%2Ccompress&amp;ixlib=php 3.3 - Cosentino"></p>
<div class="core-slider__slide__filter"></div>
<div class="core-slider__slide__card-body">
<div class="core-slider__slide__card-body__block"></div>
<div class="core-slider__slide__card-body__block">
<div class="core-slider__slide__card-body__arrow"></div>
</p></div>
</p></div>
</p></div>
<p>    <script type="text/javascript">
