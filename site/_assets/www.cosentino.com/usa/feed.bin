                navigationSelector: "#slider-nav-8414156a-84cf-49c7-9fa5-c423ce4b55bc_mobile",
                dotsSelector: "#slider-dots-8414156a-84cf-49c7-9fa5-c423ce4b55bc_mobile",
                numItems: 1,
                numItemsTablet: 1,
                numItemsMobile: 1,
                hasLightshow: false,
                hasModal: false,
                loop: false,
                ajaxUrl: "https://www.cosentino.com/usa/wp-admin/admin-ajax.php?action=get_slider_modal_info"
            };</p>
<p>            const sliderName = 'slider_' + '8414156a-84cf-49c7-9fa5-c423ce4b55bc_mobile';
            window[sliderName] = new SliderHorizontal(options);
        });
    </script>
</div>
</p></div>
<div class="text">
<div class="row mx-0 mr-lg-5">
<div class="paragraf px-0 col-lg-6">
<p class="font-15 font-light">Michelle started working with Cosentino back in 2005 when she was working in the Outer Banks of North Carolina. Silestone pricing was comparable to granite, which allowed her to upsell the product. Besides its pricing advantages, Silestone is low-maintenance and has consistent patterns, which minimizes the need to visit the slab yard, which was a couple of hours away. Additionally, Michelle appreciates the warranty and Cosentino’s customer service. Silestone was a win-win for Michelle, and 20+ years later, she continues to specify it in her projects.</p>
</p></div>
<div class="paragraf px-0 col-lg-6">
<p class="font-15 font-light">“I was invited to a Cosentino designer event a few years back and saw Sensa Dakar slabs in person,” Michelle reminisced, “I snapped photos, immediately sent them to my client, and she fell in love. She loves her Dakar countertop more every year!”</p>
</p></div>
</p></div>
</p></div>
</p></div>
<div class="d-tablet-none col-md-6 px-0">
<div id="slider-8414156a-84cf-49c7-9fa5-c423ce4b55bc" class="core-slider keen-slider">
<div class=" core-slider__slide keen-slider__slide number-slide-0" data-id="" data-src="https://imgix.cosentino.com/usa/wp-content/uploads/8L4A0611-1.jpg?auto=format%2Ccompress&ixlib=php-3.3.0" >
                                                <img decoding="async" class="core-slider__slide__image" src="https://imgix.cosentino.com/usa/wp-content/uploads/8L4A0611-1.jpg?auto=format%2Ccompress&amp;ixlib=php-3.3.0" alt="Image 106 of 8L4A0611 1.jpg?auto=format%2Ccompress&amp;ixlib=php 3.3 in Kitchen &amp; Bath Galleries - Cosentino" title="Image of 8L4A0611 1.jpg?auto=format%2Ccompress&amp;ixlib=php 3.3 - Cosentino"></p>
<div class="core-slider__slide__filter"></div>
<div class="core-slider__slide__card-body">
<div class="core-slider__slide__card-body__block"></div>
<div class="core-slider__slide__card-body__block">
<div class="core-slider__slide__card-body__arrow"></div>
</p></div>
</p></div>
</p></div>
<p>    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", function() {
            const options = {
                id: "8414156a-84cf-49c7-9fa5-c423ce4b55bc",
