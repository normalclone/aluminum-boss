    <link rel="stylesheet" type="text/css" href="https://www.cosentino.com/landings/landings-content/themes/b2c-child/styles/css/landings/ct-quarry.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css">
