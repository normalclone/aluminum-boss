# --- .NET ---------------------------------------------------------------------------------
bin/
obj/
.vs/
*.user

# The content database. Deliberately not committed: this repo is public, and the file carries
# the admin password hash. It is also not a source file - ContentSeeder rebuilds it from
# wwwroot/_data/*.json on first run, so a fresh clone starts with the site's own content.
#
# The consequence is worth knowing: anything edited through the admin lives only in this file
# and is therefore not in git. It needs its own backup.
App_Data/*.db
App_Data/*.db-shm
App_Data/*.db-wal

# --- static site ---------------------------------------------------------------------------
# Backups written by the section injectors before each run
*.pre-factory
*.pre-globe
*.prefixbak
*.bak

# Local check output
merged-check*.json

# regenerated by build/shell.py
build/shell-*.html

# Anh moc nen cua bo do: sinh lai duoc bang tools/parity.js --save, va 8 MB
# anh khong thuoc ve lich su git. metrics.json thi co commit.
tools/baseline/*.png
tools/node_modules/
tools/after/
tools/after*/

# Moc nen chup tu GitHub Pages khi no con dung danh sach bang JS. Day la moc "truoc"
# cua ca Task 9; mat di khi site/ duoc sinh lai va day len. Sinh lai bang parity.js --save.
tools/baseline/pages-js/

# Moc nen sau Task 9, chup tu chinh may chu. Dung cai nay tu day tro di.
tools/baseline/task9/

# Moc nen sau Task 10, chup tu may chu o dia chi moi (/news/press-line-2500/). Ten file sinh tu
# duong dan, nen moc task9 khong dung lai duoc cho bay trang chi tiet. Dung cai nay tu day.
tools/baseline/task10/

# fanout.py nap slugs.py nhu mot module nen Python sinh bytecode canh no.
__pycache__/

# Moc nen sau Task 14 - da go dong "Demonstration site" khoi chan trang, nen moc task10 khong
# dung lai duoc.
tools/baseline/task14/

# Moc nen sau Task 15. Chu cua tung muc gio nam trong <span> rieng de sua duoc, nen net chu
# duoc ve lai o ranh gioi - khong co gi xe dich, nhung moc task14 khong dung lai duoc. Day la
# moc de dung tu nay.
tools/baseline/task15/

# Moc nen sau Task 20: khoi "New" tren trang chu doi chu.
tools/baseline/task19/

# Moc nen sau khi sau tam banner cua khach vao trang.
tools/baseline/task22/

# Moc nen sau khi an nut EN/VI: dau trang doi tren CA 15 trang, nen task22 khong dung lai duoc.
# Day la moc de dung tu nay.
tools/baseline/task23/

# Ban tinh sinh tu may chu bang tools/publish-static.js. 369 tep tai nguyen chep sang cong 105
# trang - tat ca deu sinh lai duoc trong mot phut, va khong cai nao la nguon.
export/

# Yeu cau lien he do khach that gui, va co so du lieu lich su. Khong thuoc ve git.
App_Data/enquiries.jsonl

# Phim huong dan sinh ra boi tools/guide-video.js. Quay lai duoc bat cu luc nao, va mot tep mp4
# vai megabyte trong git la thu khong ai diff duoc.
tools/out/

# Noi dung cao ve tu bossdoor.vn.
#
# raw/ la 78 MB HTML tho cua mot site khac; extracted.json la 2,85 MB chu tieng Viet boc ra tu
# no. Ca hai deu sinh lai duoc (crawl-bossdoor.js roi extract-bossdoor.js) va KHONG cai nao la
# nguon cua du an nay - nguon la ban tieng Anh sau khi dich, nam trong wwwroot/_data/*.json.
#
# import/index.json THI CO COMMIT: no la bien ban cua dot cao (cao luc nao, 307 muc nao, 1240
# luot anh nao) va no nho. Mat no thi khong biet da cao gi.
import/raw/
import/extracted.json
