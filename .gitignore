# --- .NET ---------------------------------------------------------------------------------
bin/
obj/
.vs/
*.user

# The content database. Deliberately not committed: this repo is public, and the file carries
# the admin password hash. It is also not a source file - ContentSeeder rebuilds it from
# wwwroot/_data/*.json on first run, so a fresh clone starts with the site's own content.
#
# The consequence is worth knowing: anything edited through the admin lives only in this file
# and is therefore not in git. It needs its own backup.
App_Data/*.db
App_Data/*.db-shm
App_Data/*.db-wal

# --- static site ---------------------------------------------------------------------------
# Backups written by the section injectors before each run
*.pre-factory
*.pre-globe
*.prefixbak
*.bak

# Local check output
merged-check*.json

# regenerated by build/shell.py
build/shell-*.html

# Anh moc nen cua bo do: sinh lai duoc bang tools/parity.js --save, va 8 MB
# anh khong thuoc ve lich su git. metrics.json thi co commit.
tools/baseline/*.png
tools/node_modules/
tools/after/
tools/after*/

# Moc nen chup tu GitHub Pages khi no con dung danh sach bang JS. Day la moc "truoc"
# cua ca Task 9; mat di khi site/ duoc sinh lai va day len. Sinh lai bang parity.js --save.
tools/baseline/pages-js/
